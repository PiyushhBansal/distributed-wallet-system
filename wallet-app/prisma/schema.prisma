generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User{
  id     Int @id @default(autoincrement())
  name   String
  email  String @unique
  passwordHash  String
  wallet  Wallet?
}

model Wallet{
  id     Int @id @default(autoincrement())
  userId Int @unique
  balancePaise Int @default(0)
  user User @relation(fields: [userId], references: [id])
}